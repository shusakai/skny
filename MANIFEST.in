include AUTHORS.rst
include CONTRIBUTING.rst
include HISTORY.rst
include LICENSE
include README.rst
include CITATION.cff
include llms.txt
include AGENTS.md
include requirements.txt

recursive-include tests *
recursive-exclude * __pycache__
recursive-exclude * *.py[co]

recursive-include docs *.rst conf.py Makefile make.bat
# tutorial notebooks (with outputs, ~10 MB) and images are on GitHub / Read the Docs, not in the sdist
prune docs/notebooks
prune docs/_static
prune docs/_extra
prune _images
